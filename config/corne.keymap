#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        behaviors {
            // tap dance on middle thumb key -- just hold it to raise the layer,
            // tap-hold for SUPER/GUI key
            td_ls: tap_dance_0 {
                compatible = "zmk,behavior-tap-dance";
                #binding-cells = <0>;
                tapping-term-ms = <300>;
                bindings = <&mo 1>, <&kp LGUI>;
            };
            // tap dance for RALT/ALT switch 
            td_alt: tap_dance_1 {
                compatible = "zmk,behavior-tap-dance";
                #binding-cells = <0>;
                tapping-term-ms = <300>;
                bindings = <&kp RALT>, <&kp LALT>;
            };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
// | ESC  |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | SHFT |
//                    | CTRL| LWR | SPC |   | ENT | RSE  | ALT |
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp ESC &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                  &kp LCTRL &td_ls &kp SPACE   &kp RET &mo 2 &td_alt
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
// | SHFT |     |     |     |     |     |   |     |     |     |     |     | SHFT |
//                    | CTRL|     | SPC |   | ENT | GUI | ALT |
                        bindings = <
   &kp TAB    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp DEL
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
   &kp LSHFT  &trans       &trans       &trans       &trans       &trans         &trans   &trans   &trans &trans    &trans &kp RSHFT
                                    &kp LCTRL     &trans       &kp SPACE      &kp RET  &kp LGUI   &kp LALT
                        >;
                };
                raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
// | ESC  |  ~  |     |  [  |  ]  |     |   | HOME|PG_DN|PG_UP| END |  \  |  `   |
// | SHFT |     |     |     |     |     |   |  -  |  =  |  {  |  }  | "|" | SHFT |
//                    | CTRL|     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp TAB   &kp EXCL  &kp AT    &kp HASH &kp DLLR    &kp PRCNT &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
   &kp ESC   &kp TILDE &trans    &kp LBKT &kp RBKT    &trans    &kp HOME  &kp PG_DN &kp PG_UP &kp END  &kp BSLH &kp GRAVE
   &kp LSHFT &trans    &trans    &trans   &trans      &trans    &kp MINUS &kp EQUAL &kp LBRC  &kp RBRC &kp PIPE &kp RSHFT
                       &kp LCTRL &trans   &kp SPACE   &kp RET   &trans    &kp LALT
                        >;
                };
        };

    // =========================================================================================
    // Default bindings for reference
    // -----------------------------------------------------------------------------------------
    // Default level
    // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
    // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
    // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
    //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |
    // -----------------------------------------------------------------------------------------
    // lower_layer
    // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
    // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
    // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
    //                    | GUI |     | SPC |   | ENT |     | ALT |
    // -----------------------------------------------------------------------------------------
    // raise_layer
    // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
    // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
    // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
    //                    | GUI |     | SPC |   | ENT |     | ALT |
};
